# ShadeLane Android release signing (DO NOT COMMIT real passwords)

# 1) Generate a keystore ONLY on your machine (do not share the .jks):
# keytool -genkey -v -keystore shadelane-upload.jks -keyalg RSA -keysize 2048 -validity 10000 -alias shadelane
#
# 2) Copy this file to keystore.properties in android/ and fill in values.
# 3) Wire signingConfigs in app/build.gradle (see STORE_PUBLISH.md).

storeFile=../shadelane-upload.jks
storePassword=REPLACE_ME
keyAlias=shadelane
keyPassword=REPLACE_ME
